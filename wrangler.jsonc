{
  "name": "day-daw-rec-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "day-daw-rec-db",
      "database_id": "30b35c58-203b-4555-821a-91c8295e7a55",
      "migrations_dir": "./migrations"
    }
  ]
}
